-- DEFINE 조건 밖에서의 같은 표기이며, 위 두 경우가 이것과 일치해야 한다:
CREATE FUNCTION rpr_recstar_plain(x int, y int) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
    rec rpr_pair;
BEGIN
    rec := ROW(x, y);
    RETURN (SELECT ROW(rec.*)::text FROM rpr_rec LIMIT 1);
END
$$;
