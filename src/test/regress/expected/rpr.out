-- 고정 길이 패턴의 기본 테스트 (A A A = 정확히 3)
SELECT company, tdate, price, count(*) OVER w
 FROM rpr_price
 WINDOW w AS (
 PARTITION BY company
 ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING
 INITIAL
 PATTERN (A A A)
 DEFINE
  A AS price >= 140 AND price <= 150
);
