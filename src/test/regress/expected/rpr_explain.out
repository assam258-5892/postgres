           (4, ARRAY[''A'']), (5, ARRAY[''A'']), (6, ARRAY[''A'', ''B'']),
           (7, ARRAY[''A'', ''B'']), (8, ARRAY[''A'', ''B'']), (9, ARRAY[''A'']))
SELECT id, first_value(id) OVER w AS match_start, last_value(id) OVER w AS match_end
