    FROM generate_series(1, 50) v
) t
WINDOW w AS (
    PARTITION BY p
    ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING
    AFTER MATCH SKIP PAST LAST ROW
    PATTERN (A+ B)
    DEFINE A AS val < 5, B AS val >= 5
);');
