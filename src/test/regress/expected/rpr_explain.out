-- (A{2,})*는 a*로 평탄화되면 안 된다: {0} UNION [2, INF) 개수는 1 을 도달
-- 불가능하게 남긴다.  플래너는 이를 a*가 아니라 (a{2,})*로 유지한다.
CREATE VIEW rpr_ev_nested_quant_no_flatten AS
SELECT count(*) OVER w
FROM generate_series(1, 6) AS s(v)
