-- int64 한계에서도 마찬가지인데, 그렇지 않으면 도달 거리 뺄셈이 wrap될 것이다.
EXPLAIN (COSTS OFF) SELECT count(*) OVER w
FROM generate_series(1,10) s(v)
WINDOW w AS (
    ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING
